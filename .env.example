# Copy to .env.local for local overrides (not committed).
# Set these in your hosting provider (Vercel, Netlify, Railway, etc.) for production.

# Django REST API base URL (no trailing slash required)
# Local example:  http://127.0.0.1:8000/api
# Production:     https://pms-backend-production-4438.up.railway.app/api
VITE_API_BASE_URL=https://pms-backend-production-4438.up.railway.app/api

# Optional overrides (usually not needed — WS is derived from VITE_API_BASE_URL)
# VITE_MAIN_API_BASE_URL=
# VITE_DPR_API_BASE_URL=
# VITE_WS_BASE_URL=wss://pms-backend-production-4438.up.railway.app
# Local WS example: VITE_WS_BASE_URL=ws://127.0.0.1:8000
